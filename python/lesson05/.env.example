# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file; it is already excluded in .gitignore.
#
# Render.com PostgreSQL "External Database URL" values typically look like:
# postgresql://<user>:<password>@<host>/<database>
#
# SQLAlchemy needs the psycopg driver named explicitly:
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/project_tracker
